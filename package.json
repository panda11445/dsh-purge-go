{
  "name": "@panda11445go/dsh-purge",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 破甲（dsh-Go / Android 适配版）：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 上游 YuJunZhiXue/dsh-purge，适配 ccch1mneyyy/dsh-Go 的 Android 本地引擎。",
  "author": "panda11445go (dsh-Go / Android port; original project by YuJunZhiXue)",
  "contributors": [
    "YuJunZhiXue — original author (https://github.com/YuJunZhiXue/dsh-purge)"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panda11445/dsh-purge-go.git"
  },
  "homepage": "https://github.com/panda11445/dsh-purge-go#readme",
  "bugs": {
    "url": "https://github.com/panda11445/dsh-purge-go/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "dsh-go",
    "android",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dshTargets": [
    "0.2.2-rc.1",
    "0.2.1-rc.4",
    "0.2.1-rc.5",
    "0.2.1-rc.2"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "!docs/screenshots",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "README-ANDROID.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:dshgo": "node --test test/dshgo-panel.test.mjs",
    "test:compat": "node --test test/compat.test.mjs test/patch-variants.test.mjs",
    "compat:matrix": "node scripts/compat-matrix.mjs",
    "release:check": "node scripts/release-check.mjs",
    "doctor": "node bin/dsh-purge.js --doctor",
    "capture:snippets": "node scripts/capture-host-snippets.mjs",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "setup-profile": "node scripts/ensure-profile-bundle.mjs"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.0.3",
    "title": {
      "zh": "dsh-purge",
      "en": "dsh-purge"
    },
    "icon": "wrench",
    "contributes": {
      "panels": [
        {
          "id": "clean",
          "title": {
            "zh": "清洗",
            "en": "Clean"
          },
          "icon": "wrench",
          "placement": [
            "session.tab",
            "chat.panel",
            "features"
          ]
        }
      ],
      "composer.strip": [
        {
          "id": "status",
          "icon": "wrench",
          "panel": "clean"
        }
      ]
    }
  },
  "dshTarget": "0.2.2-rc.1"
}
